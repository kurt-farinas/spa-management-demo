  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Amber fill, ink text; the one main action per view (New sale, Checkout, Book).",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M224 128a8 8 0 0 1-8 8h-80v80a8 8 0 0 1-16 0v-80H40a8 8 0 0 1 0-16h80V40a8 8 0 0 1 16 0v80h80a8 8 0 0 1 8 8Z\"/></svg>New sale</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 20px;border:0;border-radius:6px;background:var(--color-accent);color:var(--color-ink);font:600 14px/20px Figtree,system-ui,sans-serif;cursor:pointer}.ds-btn-primary:hover{filter:brightness(.95)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-rail);outline-offset:2px}"
    },
    {
      "name": "Floating New Sale (phone)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The primary button as a 48px pill floating above the bottom nav on phones.",
      "html": "<button class=\"ds-fab\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M224 128a8 8 0 0 1-8 8h-80v80a8 8 0 0 1-16 0v-80H40a8 8 0 0 1 0-16h80V40a8 8 0 0 1 16 0v80h80a8 8 0 0 1 8 8Z\"/></svg>New sale</button>",
      "css": ".ds-fab{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px 0 16px;border:0;border-radius:9999px;background:var(--color-accent);color:var(--color-ink);font:600 15px Figtree,system-ui,sans-serif;box-shadow:0 2px 6px color-mix(in srgb,var(--color-ink) 18%,transparent);cursor:pointer}.ds-fab:hover{filter:brightness(.95)}.ds-fab:focus-visible{outline:2px solid var(--color-rail);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface with a hairline border; every other button.",
      "html": "<button class=\"ds-btn-secondary\">Log out</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:1px solid var(--color-line);border-radius:6px;background:var(--color-surface);color:var(--color-ink);font:600 14px/20px Figtree,system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:var(--color-soft)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-rail);outline-offset:2px}"
    },
    {
      "name": "Filter Pills",
      "kind": "chip",
      "refersTo": "pill-on",
      "description": "Round 44px filter pills; selected is rail green.",
      "html": "<div class=\"ds-pills\"><button class=\"ds-pill ds-pill-on\">All</button><button class=\"ds-pill\">Massage</button><button class=\"ds-pill\">Facial</button></div>",
      "css": ".ds-pills{display:flex;gap:8px}.ds-pill{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:9999px;border:1px solid var(--color-line);background:var(--color-surface);color:var(--color-ink);font:400 13px Figtree,system-ui,sans-serif;cursor:pointer;transition:border-color .15s,background .15s}.ds-pill:hover{border-color:var(--color-rail-active)}.ds-pill-on{border-color:transparent;background:var(--color-rail);color:var(--color-rail-ink);font-weight:600}.ds-pill:focus-visible{outline:2px solid var(--color-rail);outline-offset:2px}"
    },
    {
      "name": "Status Pills and Stamps",
      "kind": "chip",
      "refersTo": "status-booked",
      "description": "Booked and Done are round pills; Cancelled and No-show stay visible as tilted bordered stamps.",
      "html": "<div class=\"ds-status\"><span class=\"ds-st ds-st-booked\">Booked</span><span class=\"ds-st ds-st-done\">Done</span><span class=\"ds-stamp ds-stamp-cancel\">Cancelled</span><span class=\"ds-stamp ds-stamp-noshow\">No-show</span></div>",
      "css": ".ds-status{display:flex;gap:8px;align-items:center;font-family:Figtree,system-ui,sans-serif}.ds-st{border-radius:9999px;padding:0 8px;font-size:11px;line-height:18px;font-weight:600}.ds-st-booked{background:color-mix(in srgb,var(--color-highlight) 45%,transparent);color:var(--color-ink)}.ds-st-done{background:var(--color-success-bg);color:var(--color-success)}.ds-stamp{border:1px solid;background:var(--color-surface);border-radius:4px;padding:0 6px;font-size:11px;line-height:16px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;transform:rotate(-2deg)}.ds-stamp-cancel{border-color:var(--color-muted);color:var(--color-muted)}.ds-stamp-noshow{border-color:var(--color-danger);color:var(--color-danger)}"
    },
    {
      "name": "StatCard",
      "kind": "card",
      "refersTo": "stat-card",
      "description": "KPI tile: muted label, tabular figure, optional note; dark rail variant leads a row.",
      "html": "<div class=\"ds-stats\"><div class=\"ds-stat\"><div class=\"ds-stat-l\">Today's sales</div><div class=\"ds-stat-v\">₱18,450</div><div class=\"ds-stat-n\">12 sales so far</div></div><div class=\"ds-stat ds-stat-dark\"><div class=\"ds-stat-l\">Net income</div><div class=\"ds-stat-v\">₱212,300</div><div class=\"ds-stat-n\">Month so far</div></div></div>",
      "css": ".ds-stats{display:flex;gap:12px;font-family:Figtree,system-ui,sans-serif}.ds-stat{border:1px solid var(--color-line);background:var(--color-surface);border-radius:8px;padding:16px 20px;min-width:180px}.ds-stat-l{font-size:13px;font-weight:600;color:var(--color-muted)}.ds-stat-v{margin-top:4px;font-size:28px;line-height:36px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--color-ink)}.ds-stat-n{margin-top:4px;font-size:13px;color:var(--color-muted)}.ds-stat-dark{background:var(--color-rail);border-color:var(--color-rail)}.ds-stat-dark .ds-stat-l,.ds-stat-dark .ds-stat-v,.ds-stat-dark .ds-stat-n{color:var(--color-rail-ink)}"
    },
    {
      "name": "Appointment Rows with Category Band",
      "kind": "custom",
      "refersTo": "cat-massage",
      "description": "4px category band at the row edge with the service named beside it; the Facial band carries an inset ink hairline.",
      "html": "<div class=\"ds-rows\"><div class=\"ds-row\"><span class=\"ds-band ds-band-massage\"></span><span class=\"ds-time\">10:00</span><span><b>Maria Santos</b><br><small>Swedish massage</small></span></div><div class=\"ds-row\"><span class=\"ds-band ds-band-facial\"></span><span class=\"ds-time\">11:30</span><span><b>Ana Reyes</b><br><small>Gold facial</small></span></div></div>",
      "css": ".ds-rows{border:1px solid var(--color-line);border-radius:8px;background:var(--color-surface);overflow:hidden;font-family:Figtree,system-ui,sans-serif;color:var(--color-ink);min-width:280px}.ds-row{display:flex;gap:12px;align-items:stretch;padding:10px 20px 10px 0;border-top:1px solid var(--color-line)}.ds-row:first-child{border-top:0}.ds-band{width:4px;flex-shrink:0}.ds-band-massage{background:var(--color-cat-massage)}.ds-band-facial{background:var(--color-cat-facial);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--color-ink) 25%,transparent)}.ds-time{width:56px;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;padding-left:12px}.ds-row b{font-size:14px}.ds-row small{font-size:12px;color:var(--color-muted)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "44px surface field with hairline border.",
      "html": "<input class=\"ds-input\" placeholder=\"Search clients\">",
      "css": ".ds-input{height:44px;padding:0 12px;border:1px solid var(--color-line);border-radius:6px;background:var(--color-surface);color:var(--color-ink);font:400 14px Figtree,system-ui,sans-serif;min-width:260px}.ds-input::placeholder{color:var(--color-muted)}.ds-input:focus-visible{outline:2px solid var(--color-rail);outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Green side rail; active item filled rail-active with a 3px calamansi marker.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav ds-nav-on\" href=\"#\">Dashboard</a><a class=\"ds-nav\" href=\"#\">Appointments</a><a class=\"ds-nav\" href=\"#\">Clients</a><div class=\"ds-group\">REPORTS</div><a class=\"ds-nav\" href=\"#\">Sales report</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:4px;width:232px;padding:24px 16px;background:var(--color-rail);font-family:Figtree,system-ui,sans-serif}.ds-nav{display:flex;align-items:center;min-height:44px;padding:0 12px;border-left:3px solid transparent;border-radius:6px;color:var(--color-rail-ink);font-size:14px;font-weight:500;text-decoration:none;transition:background .15s}.ds-nav:hover{background:var(--color-rail-active)}.ds-nav-on{background:var(--color-rail-active);border-left-color:var(--color-highlight);font-weight:600}.ds-nav:focus-visible{outline:2px solid var(--color-rail-ink);outline-offset:2px}.ds-group{padding:24px 12px 8px;font-size:11px;font-weight:600;letter-spacing:.14em;color:var(--color-rail-ink)}"
